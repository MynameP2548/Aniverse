generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String         @id @default(cuid())
  email        String         @unique
  password     String
  name         String
  role         Role           @default(USER)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  favorites    Favorite[]
  reviews      Review[]
  watchHistory WatchHistory[]
}

model Anime {
  id          String      @id @default(cuid())
  title       String
  titleEn     String?
  description String?
  coverImage  String?
  bannerImage String?
  genres      String[]
  status      AnimeStatus @default(ONGOING)
  releaseYear Int?
  rating      Float?      @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  featured    Boolean     @default(false)
  heroLogo    String?
  heroOrder   Int         @default(0)
  heroTrailer String?
  slug        String      @unique
  episodes    Episode[]
  favorites   Favorite[]
  reviews     Review[]
  seasons     Season[]
}

model Episode {
  id            String         @id @default(cuid())
  animeId       String
  seasonId      String?
  episodeNumber Int
  title         String?
  videoUrl      String
  thumbnail     String?
  duration      Int?
  createdAt     DateTime       @default(now())
  anime         Anime          @relation(fields: [animeId], references: [id], onDelete: Cascade)
  season        Season?        @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  watchHistory  WatchHistory[]

  @@unique([animeId, seasonId, episodeNumber])
}

model Season {
  id           String    @id @default(cuid())
  animeId      String
  seasonNumber Int
  title        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  episodes     Episode[]
  anime        Anime     @relation(fields: [animeId], references: [id], onDelete: Cascade)

  @@unique([animeId, seasonNumber])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  animeId   String
  createdAt DateTime @default(now())
  anime     Anime    @relation(fields: [animeId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, animeId])
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  animeId   String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  anime     Anime    @relation(fields: [animeId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, animeId])
}

model WatchHistory {
  id        String   @id @default(cuid())
  userId    String
  episodeId String
  progress  Int      @default(0)
  updatedAt DateTime @updatedAt
  episode   Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, episodeId])
}

enum Role {
  USER
  ADMIN
}

enum AnimeStatus {
  ONGOING
  COMPLETED
}
